{
  "name": "@a-little-world/little-world-frontend-shared",
  "version": "0.2.0",
  "description": "Shared frontend library for Little World applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-little-world/little-world-frontend-shared.git"
  },
  "keywords": [
    "react",
    "react-native",
    "frontend",
    "shared",
    "components",
    "utils"
  ],
  "author": "Little World",
  "license": "MIT",
  "devDependencies": {
    "@a-little-world/little-world-design-system": "^3.1.2",
    "@a-little-world/little-world-design-system-core": "^1.17.1",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^16.18.126",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.18",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@a-little-world/little-world-design-system": "^3.1.2",
    "@a-little-world/little-world-design-system-core": "^1.17.1",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "styled-components": "^6.1.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  }
}
